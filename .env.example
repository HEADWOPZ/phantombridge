# Copy to .env (never commit real values).
# Public defaults work for local demo. Optional keys are documented, never required.

# --- MCP / Python ---
# JSON-RPC endpoint. Public mainnet is the default when unset.
# Rate limits apply. Alternatives: https://solana-rpc.publicnode.com
# Optional paid/free keys (Helius, Triton, QuickNode) — not required.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter public lite API (no key). Paid Jupiter portal key is optional.
JUPITER_API_URL=https://lite-api.jup.ag
# JUPITER_API_KEY=

# DexScreener public REST (LP / pair age hints). Override only if proxied.
DEXSCREENER_API_URL=https://api.dexscreener.com

# If 1, tools fail when SOLANA_RPC_URL is empty (no silent default).
PHANTOMBRIDGE_REQUIRE_RPC=0

# If 1, every tool requires a valid pubkey-bound session token from the web app.
PHANTOMBRIDGE_REQUIRE_SESSION=0

# Optional: pin tools to one wallet (must match session pubkey when present).
# PHANTOMBRIDGE_BOUND_PUBKEY=

# HTTP timeout seconds for RPC / Jupiter / DexScreener.
PHANTOMBRIDGE_HTTP_TIMEOUT=20

# --- Web mini-app (web/.env) ---
# Get an App ID at https://phantom.com/portal (safe in client code).
# Leave empty for injected-Phantom-only local demo (no Google/Apple).
VITE_PHANTOM_APP_ID=
VITE_PHANTOM_REDIRECT_URL=http://localhost:5173/callback
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SESSION_TTL_SECONDS=900
